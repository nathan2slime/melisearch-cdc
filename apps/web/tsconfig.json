{
  "extends": "@repo/typescript-config/rsbuild.json",
  "include": [
    "src",
    "rsbuild.config.ts"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "strictNullChecks": true,
    "paths": {
      "~/*": [
        "./src/*"
      ]
    },
    "types": [
      "@rsbuild/core/types"
    ]
  }
}